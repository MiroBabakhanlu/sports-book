datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Sport {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  api_provider String
  id_api       String
  slug         String   @unique
  is_active    Boolean
  created_at   DateTime @default(now())

  // Relations
  leagues League[]
  teams   Team[]
  markets Market[]

  @@map("SPORT")
}

model League {
  id         Int      @id @default(autoincrement())
  sport_id   Int
  name       String
  country    String?
  id_api     String   @unique
  slug       String   @unique
  is_active  Boolean
  created_at DateTime @default(now())

  is_visible    Boolean @default(true)
  display_order Int     @default(999)
  is_pinned     Boolean @default(false)

  // Relations
  sport             Sport              @relation(fields: [sport_id], references: [id])
  seasons           Season[]
  missingMatchStats MissingMatchStat[]

  @@map("LEAGUE")
}

model Season {
  id         Int       @id @default(autoincrement())
  league_id  Int
  year       String
  start_date DateTime?
  end_date   DateTime?
  is_current Boolean
  id_api     String

  // Relations
  league             League              @relation(fields: [league_id], references: [id])
  matches            Match[]
  teamSeasonAverages TeamSeasonAverage[]
  teamStreaks        TeamStreak[]
  teamStandings      TeamStanding[]
  missingMatchStats  MissingMatchStat[]

  @@unique([league_id, id_api], name: "id_api_league_id") //new
  @@map("SEASON")
}

model Team {
  id         Int     @id @default(autoincrement())
  sport_id   Int
  name       String
  short_name String?
  logo_url   String?
  id_api     String  @unique
  country    String?
  is_active  Boolean

  // Relations
  sport              Sport               @relation(fields: [sport_id], references: [id])
  homeMatches        Match[]             @relation("HomeTeamMatches")
  awayMatches        Match[]             @relation("AwayTeamMatches")
  wonMatches         Match[]             @relation("WinnerTeamMatches")
  matchTeamStats     MatchTeamStat[]
  teamSeasonAverages TeamSeasonAverage[]
  teamStreaks        TeamStreak[]
  teamStandings      TeamStanding[]
  missingMatchStats  MissingMatchStat[]
  streakResults      StreakResult[]

  @@map("TEAM")
}

model Match {
  id             Int       @id @default(autoincrement())
  season_id      Int
  home_team_id   Int
  away_team_id   Int
  matchday       Int?
  kickoff_at     DateTime?
  status         String
  home_score     Int?
  away_score     Int?
  winner_team_id Int?
  id_api         String    @unique
  venue          String?
  fetched_at     DateTime  @default(now())

  // Relations
  season        Season             @relation(fields: [season_id], references: [id])
  homeTeam      Team               @relation("HomeTeamMatches", fields: [home_team_id], references: [id])
  awayTeam      Team               @relation("AwayTeamMatches", fields: [away_team_id], references: [id])
  winnerTeam    Team?              @relation("WinnerTeamMatches", fields: [winner_team_id], references: [id])
  stats         MatchTeamStat[]
  matchOdds     MatchOdds[]
  missingStats  MissingMatchStat[]
  streakResults StreakResult[]

  @@map("MATCH")
}

model Market {
  id                 Int                 @id @default(autoincrement())
  sport_id           Int
  name               String
  slug               String              @unique
  scope              String
  description        String?
  id_api             String?             @unique
  // Relations
  sport              Sport               @relation(fields: [sport_id], references: [id])
  matchTeamStats     MatchTeamStat[]
  teamSeasonAverages TeamSeasonAverage[]
  teamStreaks        TeamStreak[]
  matchOdds          MatchOdds[]
  missingMatchStats  MissingMatchStat[]
  streakResults      StreakResult[]

  @@map("MARKET")
}

model MissingMatchStat {
  id           Int      @id @default(autoincrement())
  match_id     Int
  team_id      Int
  market_id    Int
  league_id    Int
  season_id    Int
  match_id_api String
  detected_at  DateTime @default(now())

  // Relations
  match  Match  @relation(fields: [match_id], references: [id])
  team   Team   @relation(fields: [team_id], references: [id])
  market Market @relation(fields: [market_id], references: [id])
  league League @relation(fields: [league_id], references: [id])
  season Season @relation(fields: [season_id], references: [id])

  // One row per match+team+market - re-running pop-db.js for the same match just
  // upserts (refreshes detected_at) instead of piling up duplicate rows.
  @@unique([match_id, team_id, market_id], name: "match_id_team_id_market_id")
  @@map("MISSING_MATCH_STAT")
}

model MatchOdds {
  id           Int      @id @default(autoincrement())
  match_id     Int
  market_id    Int
  bookmaker_id Int
  slug         String // e.g., "over-2-5", "under-2-5", "home", "away"
  odd          Decimal // The actual decimal value (e.g., 1.95)
  fetched_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  match     Match     @relation(fields: [match_id], references: [id])
  market    Market    @relation(fields: [market_id], references: [id])
  bookmaker Bookmaker @relation(fields: [bookmaker_id], references: [id])

  // Simple unique constraint to prevent duplicate lines for the same match
  @@unique([match_id, market_id, bookmaker_id, slug], name: "match_market_bookmaker_slug")
  @@map("MATCH_ODDS")
}

model Bookmaker {
  id             Int      @id @default(autoincrement())
  name           String
  logo_url       String?
  is_active      Boolean  @default(true) // Global active status
  created_at     DateTime @default(now())
  is_default     Boolean  @default(false) // If true, acts as global fallback
  affiliate_link String?

  // Relations
  regions   BookmakerRegion[]
  matchOdds MatchOdds[]

  @@map("BOOKMAKER")
}

model BookmakerRegion {
  id           Int     @id @default(autoincrement())
  bookmaker_id Int
  region_code  String? @unique
  is_active    Boolean @default(true)

  // Relation
  bookmaker Bookmaker @relation(fields: [bookmaker_id], references: [id])

  @@map("BOOKMAKER_REGION")
}

model MatchTeamStat {
  id        Int     @id @default(autoincrement())
  match_id  Int
  team_id   Int
  market_id Int
  value     Decimal
  side      String

  // Relations
  match  Match  @relation(fields: [match_id], references: [id])
  team   Team   @relation(fields: [team_id], references: [id])
  market Market @relation(fields: [market_id], references: [id])

  @@unique([match_id, team_id, market_id])
  @@map("MATCH_TEAM_STAT")
}

model TeamSeasonAverage {
  id              Int      @id @default(autoincrement())
  team_id         Int
  season_id       Int
  market_id       Int
  avg_value       Decimal
  avg_value_home  Decimal?
  avg_value_away  Decimal?
  matches_played  Int
  recalculated_at DateTime @updatedAt

  // Relations
  team   Team   @relation(fields: [team_id], references: [id])
  season Season @relation(fields: [season_id], references: [id])
  market Market @relation(fields: [market_id], references: [id])

  @@map("TEAM_SEASON_AVERAGE")
}

model TeamStreak {
  id               Int      @id @default(autoincrement())
  team_id          Int
  season_id        Int
  market_id        Int
  streak_length    Int
  streak_direction String
  confidence       Decimal? // ⭐ Streak Strength Score, 0–100
  recalculated_at  DateTime @updatedAt

  team   Team   @relation(fields: [team_id], references: [id])
  season Season @relation(fields: [season_id], references: [id])
  market Market @relation(fields: [market_id], references: [id])

  @@unique([team_id, season_id, market_id], name: "team_id_season_id_market_id")
  @@map("TEAM_STREAK")
}

model TeamStanding {
  id              Int      @id @default(autoincrement())
  team_id         Int
  season_id       Int
  position        Int
  played          Int
  won             Int
  drawn           Int
  lost            Int
  goals_for       Int
  goals_against   Int
  goal_difference Int
  points          Int
  recalculated_at DateTime @updatedAt

  team   Team   @relation(fields: [team_id], references: [id])
  season Season @relation(fields: [season_id], references: [id])

  @@unique([team_id, season_id], name: "team_id_season_id")
  @@map("TEAM_STANDING")
}

model ClickLog {
  id         Int      @id @default(autoincrement())
  streak_id  String // raw "streak_921" style id, analytics only - no FK, not validated against TeamStreak
  bookmaker  String
  click_type String
  country    String?
  session_id String?
  created_at DateTime @default(now())

  @@map("CLICK_LOG")
}

model ApiToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("API_TOKEN")
}

// Every error thrown by the "main" endpoints (bookmakers/leagues/streaks/clicks/
// matchup/standings - see server.js's mounting comment) gets one row here via
// errorMiddleware.js, regardless of status code - a 404 on a bad streak id is
// as worth reviewing later as a 500. No FK/relations, same standalone-log
// pattern as ClickLog above.
model ErrorLog {
  id           Int      @id @default(autoincrement())
  endpoint     String // req.originalUrl, e.g. "/api/streaks/streak_921"
  method       String // GET, POST, ...
  status_code  Int
  message      String
  stack        String?
  query_params String? // JSON.stringify(req.query) when present, for reproducing the request
  created_at   DateTime @default(now())

  @@map("ERROR_LOG")
}

// One row per (team, market) streak that was being shown as an upcoming
// prediction for a match that has since finished - written once, at the
// moment streak-sync-scheduler.js detects that match finished, by reading
// whatever TeamStreak/TeamSeasonAverage/odds state was current right then
// (i.e. exactly what a user would have seen on the streak card before this
// match kicked off). result is always hit/miss - never pending (this row
// only ever gets created once the match already has a final score) or void
// (a cancelled/abandoned match just never gets a row here, for lack of a
// real outcome to grade against).
model StreakResult {
  id                Int      @id @default(autoincrement())
  match_id          Int
  team_id           Int
  market_id         Int
  streak_count      Int
  confidence        Decimal?
  direction         String // 'over' | 'under' - meaningless for binary markets, kept for numeric ones
  threshold         Decimal? // null for binary markets (oddeven/both-teams-score)
  predicted_outcome String? // binary markets only: 'odd'/'even'/'yes'/'no'
  avg_value         Decimal? // season avg_value (rate, for binary markets) at the moment of capture
  odds_value        Decimal?
  odds_bookmaker    String?
  actual_value      Decimal // the market's real value in the finished match
  result            String // 'hit' | 'miss'
  created_at        DateTime @default(now())

  match  Match  @relation(fields: [match_id], references: [id])
  team   Team   @relation(fields: [team_id], references: [id])
  market Market @relation(fields: [market_id], references: [id])

  @@map("STREAK_RESULT")
}
